APP_DATA_DIR=./data
APP_ENCRYPTION_KEY=INVALID_REPLACE_WITH_A_REAL_KEY
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
API_PROXY_TARGET=http://127.0.0.1:3000
WORKER_PROVIDER_MODULE=./worker-providers.js
WORKER_ID=worker-local
WORKER_POLL_INTERVAL_MS=1000
ROUND_PARTITION_SEED=round-partition-v1
ROUND_MINIMUM_RESERVED=1
ROUND_RESERVED_RATIO=0.2
ROUND_MAX_PROPOSALS=3

# Opcional: caminho absoluto do Chromium do sistema em distribuições Linux sem binário gerenciado compatível.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
